{
  "description": "Route prompts starting with /agy (or agy:) to Antigravity via the ACP bridge.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bridge/codex-hook.mjs\"",
            "timeout": 900,
            "statusMessage": "Antigravity 工作中…"
          }
        ]
      }
    ]
  }
}
